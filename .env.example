# ---- Naija Routes configuration -------------------------------------------
# Every value here is optional. With an empty .env the app still runs fully
# offline using the bundled Nigerian gazetteer and highway graph.

# HTTP
PORT=3000
HOST=0.0.0.0

# Where the SQLite file lives
DATABASE_PATH=./data/runtime/naija-routes.db

# Seed the database with demo reports on first boot (1 = yes)
SEED_ON_BOOT=1

# ---- Upstream services (optional) -----------------------------------------
# When these are reachable the app uses them for real road geometry and
# worldwide geocoding. When they time out, the offline engine takes over
# automatically — no configuration change needed.
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
UPSTREAM_TIMEOUT_MS=4000
# Set to 0 to force pure-offline mode (useful for demos and air-gapped kits)
UPSTREAM_ENABLED=1

# Contact string sent to Nominatim as required by their usage policy
CONTACT_EMAIL=you@example.com

# ---- Assistant (optional) --------------------------------------------------
# With no key the assistant answers from the live database using its built-in
# reasoning engine. With a key it additionally phrases answers with an LLM.
# Supported: anthropic | openai | none
ASSISTANT_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ASSISTANT_MODEL=

# ---- Limits ----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
REPORT_RATE_LIMIT_MAX=20
